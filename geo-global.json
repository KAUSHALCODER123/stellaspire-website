"<a class=\"skip-link\" href=\"#main-content\">Skip to content</a>\n\n<!-- ============ HEADER ============ -->\n<header class=\"site-header\">\n  <div class=\"site-bar\">\n    <a class=\"brand\" href=\"/home-page\" aria-label=\"Stellaspire home\">\n      <img src=\"https://cdn.prod.website-files.com/66a5fdf6d0c2ac84ca88fe93/6886351f114ee66a92aad258_WhatsApp-Image-2025-05-07-at-14.24.03.jpeg\" alt=\"Stellaspire\" width=\"54\" height=\"57\">\n    </a>\n\n    <nav id=\"site-nav\" class=\"nav-links\" aria-label=\"Main navigation\">\n      <details class=\"nav-drop\">\n        <summary>Services</summary>\n        <div class=\"drop-panel\">\n          <a href=\"/finance-accounting-recruitment\">Finance &amp; Accounting<span>Controllers, FP&amp;A, CAs, finance teams</span></a>\n          <a href=\"/cfo-executive-search\">CFO &amp; Executive Search<span>CFOs, finance heads, leadership</span></a>\n          <a href=\"/gcc-hiring\">GCC Hiring<span>Teams for Global Capability Centres</span></a>\n          <a href=\"/analytics-data-recruitment\">Analytics &amp; Data<span>Analytics leaders, data scientists</span></a>\n          <a href=\"/ai-ml-recruitment\">AI &amp; ML<span>AI engineers, ML and research roles</span></a>\n          <a href=\"/diversity-hiring\">Gender-Diversity Hiring<span>Gender-balanced shortlists</span></a>\n          <a href=\"/women-returnship\">Women Returnship<span>Career restarts for women professionals</span></a>\n        </div>\n      </details>\n      <details class=\"nav-drop\">\n        <summary>Locations</summary>\n        <div class=\"drop-panel\">\n          <a href=\"/india\">India<span>Bengaluru, Mumbai, Delhi NCR, Hyderabad and more</span></a>\n          <a href=\"/global\">Global<span>Hiring in India from abroad</span></a>\n          <a href=\"/us\">United States<span>India teams for US companies</span></a>\n          <a href=\"/uk\">United Kingdom<span>India teams for UK companies</span></a>\n          <a href=\"/uae\">UAE<span>Dubai, Abu Dhabi and India back offices</span></a>\n          <a href=\"/singapore\">Singapore<span>India teams for Singapore companies</span></a>\n          <a href=\"/australia\">Australia<span>India teams for Australian companies</span></a>\n        </div>\n      </details>\n      <a class=\"nav-link\" href=\"/how-we-work\">How We Work</a>\n      <a class=\"nav-link\" href=\"/about\">About</a>\n      <a class=\"nav-link\" href=\"/insights\">Insights</a>\n      <a class=\"nav-link\" href=\"/jobs\">Open Roles</a>\n      <a class=\"nav-mobile-hire\" href=\"/contact\">Hire Talent \u2192</a>\n    </nav>\n\n    <a class=\"button\" href=\"/contact\">Hire Talent <span aria-hidden=\"true\">\u2197</span></a>\n\n    <button class=\"menu-toggle\" type=\"button\" aria-expanded=\"false\" aria-controls=\"site-nav\">Menu <span aria-hidden=\"true\">\u2630</span></button>\n  </div>\n</header>\n\n<main id=\"main-content\">\n<!-- ============ PAGE HERO ============ -->\n  <section class=\"page-hero\" aria-labelledby=\"page-heading\">\n    <div class=\"container\">\n      <ol class=\"breadcrumb\" aria-label=\"Breadcrumb\">\n        <li><a href=\"/home-page\">Home</a></li>\n        <li><span aria-current=\"page\">Global</span></li>\n      </ol>\n      <div class=\"page-hero-grid\">\n        <div>\n          <p class=\"eyebrow\">Hiring in India from anywhere</p>\n          <h1 id=\"page-heading\" class=\"page-title\">Hire talent in India, <span class=\"accent\">from wherever your head office is.</span></h1>\n          <p class=\"hero-lead\">Stellaspire is a women-led search firm in Bengaluru. We hire finance, accounting, analytics, AI and leadership talent in India for companies headquartered in the US, the UK, the UAE, Singapore and Australia, and we answer the entity, payroll and time-zone questions before they become the reason a hire falls through.</p>\n          <div class=\"hero-actions\">\n            <a class=\"button\" href=\"/contact\">Start a Hiring Conversation <span aria-hidden=\"true\">&#8599;</span></a>\n            <a class=\"textlink\" href=\"#countries\">Choose your country <span aria-hidden=\"true\">&#8594;</span></a>\n          </div>\n        </div>\n        <aside class=\"short-answer\" aria-label=\"The short answer\">\n          <p class=\"eyebrow\">The short answer</p>\n          <p>We run specialist searches in India for global companies: finance, accounting, analytics, AI and leadership. One recruiter per mandate, a shortlist with pay and notice periods written on it, and a working pattern agreed before the search opens.</p>\n        </aside>\n      </div>\n    </div>\n  </section>\n\n  <!-- ============ COUNTRIES ============ -->\n  <section id=\"countries\" class=\"section band-line\" aria-labelledby=\"countries-heading\">\n    <div class=\"container\">\n      <div class=\"section-top\">\n        <div>\n          <p class=\"eyebrow\">Where our clients are</p>\n          <h2 id=\"countries-heading\" class=\"h2\">Five head-office markets.</h2>\n        </div>\n        <p class=\"section-intro\">Each page covers the entity and payroll route, the overlap window and the compliance questions your team will ask.</p>\n      </div>\n      <div class=\"cards\">\n        <a class=\"card\" href=\"/us\"><p class=\"card-meta\">United States</p><h3 class=\"card-title\">India recruitment for US companies</h3><p class=\"body-copy\">Most of our American clients are not opening a captive center on day one. They need three good people in India, quickly, and nobody in-house&#8230;</p><span class=\"textlink\">Hiring from the US <span aria-hidden=\"true\">&#8594;</span></span></a>\n        <a class=\"card\" href=\"/uk\"><p class=\"card-meta\">United Kingdom</p><h3 class=\"card-title\">India recruitment for UK companies</h3><p class=\"body-copy\">The problem is rarely sourcing. It is that a London hiring manager cannot tell a strong Indian CV from a well-written one, and the agencies &#8230;</p><span class=\"textlink\">Hiring from the UK <span aria-hidden=\"true\">&#8594;</span></span></a>\n        <a class=\"card\" href=\"/uae\"><p class=\"card-meta\">UAE</p><h3 class=\"card-title\">Recruitment for UAE companies</h3><p class=\"body-copy\">Either you are hiring someone into the Emirates, usually from India, or you are putting a finance and analytics team in India to support the&#8230;</p><span class=\"textlink\">Hiring from the UAE <span aria-hidden=\"true\">&#8594;</span></span></a>\n        <a class=\"card\" href=\"/singapore\"><p class=\"card-meta\">Singapore</p><h3 class=\"card-title\">Recruitment for Singapore companies</h3><p class=\"body-copy\">A Singapore head office rarely has the headcount budget for a full regional finance team, and local hiring is tight. India gives depth at a &#8230;</p><span class=\"textlink\">Hiring from Singapore <span aria-hidden=\"true\">&#8594;</span></span></a>\n        <a class=\"card\" href=\"/australia\"><p class=\"card-meta\">Australia</p><h3 class=\"card-title\">Recruitment for Australian companies</h3><p class=\"body-copy\">The shortage at home is real, particularly in accounting and data engineering. The risk is hiring an India team that needs more supervision &#8230;</p><span class=\"textlink\">Hiring from Australia <span aria-hidden=\"true\">&#8594;</span></span></a>\n      </div>\n    </div>\n  </section>\n\n  <!-- ============ METHOD BAND ============ -->\n  <section class=\"method\" aria-labelledby=\"method-heading\">\n    <div class=\"container method-grid\">\n      <div>\n        <p class=\"eyebrow eyebrow--light\">What we are good at</p>\n        <h2 id=\"method-heading\" class=\"method-heading\"><span>We hire in one country and we know it well.</span></h2>\n      </div>\n      <div>\n        <p class=\"method-lede\">Depth in one market beats a logo map of thirty offices.</p>\n        <p class=\"method-body\">Stellaspire places people in India. That is the whole business, which is why we can tell you what a controller in Hyderabad earns this quarter, which GCC is about to lose its analytics team and why a brief priced on last year's numbers will not close. For roles outside finance, data and AI, we would rather refer you on than run a search we cannot judge.</p>\n        <a class=\"light-link\" href=\"/how-we-work\">How we run a search <span aria-hidden=\"true\">&#8594;</span></a>\n      </div>\n    </div>\n  </section>\n\n  <!-- ============ CARDS ============ -->\n  <section class=\"section band-mist\" aria-labelledby=\"models-heading\">\n    <div class=\"container\">\n      <div class=\"section-top\">\n        <div>\n          <p class=\"eyebrow\">How engagements run</p>\n          <h2 id=\"models-heading\" class=\"h2\">Three ways to work with us.</h2>\n        </div>\n        <p class=\"section-intro\">Commercial and replacement terms are agreed in writing before any search begins.</p>\n      </div>\n      <div class=\"cards\">\n        <div class=\"card\"><p class=\"card-meta\">Single roles</p><h3 class=\"card-title\">Contingency search</h3><p class=\"body-copy\">For specialist and mid-senior hires. A fee is payable only when a candidate we introduce joins.</p></div>\n        <div class=\"card\"><p class=\"card-meta\">Leadership</p><h3 class=\"card-title\">Retained search</h3><p class=\"body-copy\">For CFOs, finance heads and confidential replacements, with a written market map before the shortlist.</p></div>\n        <div class=\"card\"><p class=\"card-meta\">Team builds</p><h3 class=\"card-title\">Dedicated hiring</h3><p class=\"body-copy\">For new centres hiring several roles at once, with one recruiter, a shared hiring plan and a weekly pipeline review.</p></div>\n      </div>\n    </div>\n  </section>\n\n  <!-- ============ WHERE ============ -->\n  <section class=\"section\" aria-labelledby=\"cities-heading\">\n    <div class=\"container split\">\n      <div>\n        <p class=\"eyebrow\">Where the hiring happens</p>\n        <h2 id=\"cities-heading\" class=\"h2\">Eight Indian cities.</h2>\n        <p class=\"body-copy\">We are based in Bengaluru and run searches across India's main hiring markets. Pay, notice periods and attrition differ enough between them that we benchmark city by city.</p>\n      </div>\n      <div>\n        <div class=\"chips\" aria-label=\"Cities\"><span class=\"chip\">Bengaluru</span><span class=\"chip\">Mumbai</span><span class=\"chip\">Delhi NCR</span><span class=\"chip\">Hyderabad</span><span class=\"chip\">Pune</span><span class=\"chip\">Chennai</span><span class=\"chip\">Ahmedabad</span><span class=\"chip\">Kolkata</span></div>\n        <p class=\"eyebrow\" style=\"margin-top:40px\">Related</p>\n        <div class=\"chips\"><a class=\"chip\" href=\"/india\">All India locations &#8594;</a><a class=\"chip\" href=\"/india/bangalore-recruitment-agency\">Bengaluru &#8594;</a><a class=\"chip\" href=\"/india/mumbai-recruitment-agency\">Mumbai &#8594;</a><a class=\"chip\" href=\"/india/delhi-ncr-recruitment-agency\">Delhi NCR &#8594;</a><a class=\"chip\" href=\"/india/hyderabad-recruitment-agency\">Hyderabad &#8594;</a></div>\n      </div>\n    </div>\n  </section>\n\n  <!-- ============ FAQ ============ -->\n  <section id=\"faqs\" class=\"faq\" aria-labelledby=\"faq-heading\">\n    <div class=\"container faq-grid\">\n      <div>\n        <p class=\"eyebrow\">Global hiring questions</p>\n        <h2 id=\"faq-heading\" class=\"h2\">Questions global teams ask.</h2>\n      </div>\n      <div>\n        <div class=\"faq-row\"><h3 class=\"faq-question\"><button class=\"faq-button\" type=\"button\" aria-expanded=\"true\" aria-controls=\"faq-0\">Which countries do you work with?<span class=\"faq-icon\" aria-hidden=\"true\">&#8722;</span></button></h3><div id=\"faq-0\" class=\"faq-answer\"><p class=\"body-copy\">We work with companies headquartered in the United States, the United Kingdom, the UAE, Singapore and Australia, and with Indian businesses hiring at home. The hiring itself happens in India unless the brief is a relocation search into the Gulf.</p></div></div>\n        <div class=\"faq-row\"><h3 class=\"faq-question\"><button class=\"faq-button\" type=\"button\" aria-expanded=\"true\" aria-controls=\"faq-1\">Do we need an Indian entity to hire?<span class=\"faq-icon\" aria-hidden=\"true\">&#8722;</span></button></h3><div id=\"faq-1\" class=\"faq-answer\"><p class=\"body-copy\">No. Most first hires go through an employer of record or our staffing payroll, and move onto your own Indian entity once it exists. Offers are written so the transfer changes nothing for the employee.</p></div></div>\n        <div class=\"faq-row\"><h3 class=\"faq-question\"><button class=\"faq-button\" type=\"button\" aria-expanded=\"true\" aria-controls=\"faq-2\">How do you handle the time difference?<span class=\"faq-icon\" aria-hidden=\"true\">&#8722;</span></button></h3><div id=\"faq-2\" class=\"faq-answer\"><p class=\"body-copy\">It goes in the brief, not in the offer letter. We agree the working pattern before the search opens and test every candidate against it, because a shift expectation discovered late is the most common reason a good hire leaves within six months.</p></div></div>\n        <div class=\"faq-row\"><h3 class=\"faq-question\"><button class=\"faq-button\" type=\"button\" aria-expanded=\"true\" aria-controls=\"faq-3\">What does hiring in India actually cost?<span class=\"faq-icon\" aria-hidden=\"true\">&#8722;</span></button></h3><div id=\"faq-3\" class=\"faq-answer\"><p class=\"body-copy\">Less than most head offices expect at the analyst level and much less than they expect at controller and director level, though the gap has narrowed sharply for AI and data engineering. We benchmark by city and share the range before you approve the brief.</p></div></div>\n        <div class=\"faq-row\"><h3 class=\"faq-question\"><button class=\"faq-button\" type=\"button\" aria-expanded=\"true\" aria-controls=\"faq-4\">Which roles do you cover?<span class=\"faq-icon\" aria-hidden=\"true\">&#8722;</span></button></h3><div id=\"faq-4\" class=\"faq-answer\"><p class=\"body-copy\">Finance and accounting, FP&amp;A, controllership, treasury and risk, analytics and data, AI and ML, the engineering roles around them, and finance leadership up to CFO.</p></div></div>\n        <div class=\"faq-row\"><h3 class=\"faq-question\"><button class=\"faq-button\" type=\"button\" aria-expanded=\"true\" aria-controls=\"faq-5\">How long does a search take?<span class=\"faq-icon\" aria-hidden=\"true\">&#8722;</span></button></h3><div id=\"faq-5\" class=\"faq-answer\"><p class=\"body-copy\">Four to six weeks from brief to signed offer for specialist roles and six to ten for leadership, plus an Indian notice period that commonly runs 60 to 90 days at senior levels.</p></div></div>\n        <div class=\"faq-row\"><h3 class=\"faq-question\"><button class=\"faq-button\" type=\"button\" aria-expanded=\"true\" aria-controls=\"faq-6\">How are your fees structured?<span class=\"faq-icon\" aria-hidden=\"true\">&#8722;</span></button></h3><div id=\"faq-6\" class=\"faq-answer\"><p class=\"body-copy\">A percentage of annual fixed pay for contingency search, a staged fee for retained leadership search, and a monthly rate for dedicated team hiring. Commercial and replacement terms go to you in writing before the search starts.</p></div></div>\n        <div class=\"faq-row\"><h3 class=\"faq-question\"><button class=\"faq-button\" type=\"button\" aria-expanded=\"true\" aria-controls=\"faq-7\">Do candidates pay anything?<span class=\"faq-icon\" aria-hidden=\"true\">&#8722;</span></button></h3><div id=\"faq-7\" class=\"faq-answer\"><p class=\"body-copy\">No. Stellaspire never charges a candidate for any part of the process.</p></div></div>\n      </div>\n    </div>\n  </section>\n\n<script type=\"application/ld+json\">\n{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Service\",\"name\":\"Hire talent in India\",\"serviceType\":\"Specialist recruitment and executive search for global companies\",\"provider\":{\"@type\":\"EmploymentAgency\",\"name\":\"Stellaspire\",\"url\":\"https://www.stellaspire.com\",\"email\":\"connect@stellaspire.com\",\"address\":{\"@type\":\"PostalAddress\",\"streetAddress\":\"WeWork Prestige Central, 36 Infantry Road\",\"addressLocality\":\"Bengaluru\",\"addressRegion\":\"Karnataka\",\"postalCode\":\"560001\",\"addressCountry\":\"IN\"}},\"areaServed\":[\"US\",\"GB\",\"AE\",\"SG\",\"AU\",\"IN\"],\"description\":\"Finance, accounting, analytics, AI and leadership hiring in India for companies headquartered in the US, UK, UAE, Singapore and Australia.\",\"url\":\"https://www.stellaspire.com/global\"},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.stellaspire.com/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Global\",\"item\":\"https://www.stellaspire.com/global\"}]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Which countries do you work with?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"We work with companies headquartered in the United States, the United Kingdom, the UAE, Singapore and Australia, and with Indian businesses hiring at home. The hiring itself happens in India unless the brief is a relocation search into the Gulf.\"}},{\"@type\":\"Question\",\"name\":\"Do we need an Indian entity to hire?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. Most first hires go through an employer of record or our staffing payroll, and move onto your own Indian entity once it exists. Offers are written so the transfer changes nothing for the employee.\"}},{\"@type\":\"Question\",\"name\":\"How do you handle the time difference?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"It goes in the brief, not in the offer letter. We agree the working pattern before the search opens and test every candidate against it, because a shift expectation discovered late is the most common reason a good hire leaves within six months.\"}},{\"@type\":\"Question\",\"name\":\"What does hiring in India actually cost?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Less than most head offices expect at the analyst level and much less than they expect at controller and director level, though the gap has narrowed sharply for AI and data engineering. We benchmark by city and share the range before you approve the brief.\"}},{\"@type\":\"Question\",\"name\":\"Which roles do you cover?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Finance and accounting, FP&A, controllership, treasury and risk, analytics and data, AI and ML, the engineering roles around them, and finance leadership up to CFO.\"}},{\"@type\":\"Question\",\"name\":\"How long does a search take?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Four to six weeks from brief to signed offer for specialist roles and six to ten for leadership, plus an Indian notice period that commonly runs 60 to 90 days at senior levels.\"}},{\"@type\":\"Question\",\"name\":\"How are your fees structured?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"A percentage of annual fixed pay for contingency search, a staged fee for retained leadership search, and a monthly rate for dedicated team hiring. Commercial and replacement terms go to you in writing before the search starts.\"}},{\"@type\":\"Question\",\"name\":\"Do candidates pay anything?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. Stellaspire never charges a candidate for any part of the process.\"}}]}]}\n</script>\n<!-- ============ FOUNDER REELS (v6) ============ -->\n  <section class=\"section reels band-line\" aria-labelledby=\"reels-heading\">\n    <div class=\"container\">\n      <div class=\"section-top\">\n        <div>\n          <p class=\"eyebrow\">From our founder</p>\n          <h2 id=\"reels-heading\" class=\"h2\">Hear it from our founder.</h2>\n        </div>\n        <p class=\"section-intro\">Nikita Agrawal on how we hire, in under a minute. In Hindi and English.</p>\n      </div>\n      <div class=\"reel-row reel-row--3\">\n        <article class=\"reel-card\">\n          <button class=\"reel\" type=\"button\" data-video=\"https://cdn.prod.website-files.com/66a5fdf6d0c2ac84ca88fe93/6ac732ac031bb550498d9cc1_stellaspire-why-hire-a-consultant.mp4\" data-title=\"Why growing companies bring in a recruitment partner\" aria-label=\"Play video (23 seconds): Why growing companies bring in a recruitment partner\">\n            <img src=\"https://cdn.prod.website-files.com/66a5fdf6d0c2ac84ca88fe93/6ac773bd770ffdcf128d85a7_stellaspire-why-hire-a-consultant.jpg\" alt=\"\" width=\"540\" height=\"960\" loading=\"lazy\" decoding=\"async\">\n            <span class=\"reel-shade\"></span>\n            <span class=\"reel-play\" aria-hidden=\"true\"></span>\n            <span class=\"reel-meta\" aria-hidden=\"true\"><span class=\"reel-tag\">For employers</span><span>0:23</span></span>\n          </button>\n          <h3 class=\"reel-title\">Why growing companies bring in a recruitment partner</h3>\n          <p class=\"reel-copy\">Hiring under investor pressure with a small team? Nikita on when a specialist partner saves you time.</p>\n        </article>\n        <article class=\"reel-card\">\n          <button class=\"reel\" type=\"button\" data-video=\"https://cdn.prod.website-files.com/66a5fdf6d0c2ac84ca88fe93/6ac732ab99a67933d1f2b29f_stellaspire-background-check.mp4\" data-title=\"How we check a candidate before you meet them\" aria-label=\"Play video (35 seconds): How we check a candidate before you meet them\">\n            <img src=\"https://cdn.prod.website-files.com/66a5fdf6d0c2ac84ca88fe93/6ac773bde01304e3ada60e19_stellaspire-background-check.jpg\" alt=\"\" width=\"540\" height=\"960\" loading=\"lazy\" decoding=\"async\">\n            <span class=\"reel-shade\"></span>\n            <span class=\"reel-play\" aria-hidden=\"true\"></span>\n            <span class=\"reel-meta\" aria-hidden=\"true\"><span class=\"reel-tag\">For employers</span><span>0:35</span></span>\n          </button>\n          <h3 class=\"reel-title\">How we check a candidate before you meet them</h3>\n          <p class=\"reel-copy\">Background, motivation and fit: what we verify before a profile reaches your inbox.</p>\n        </article>\n        <aside class=\"reel-cta\">\n          <p class=\"eyebrow eyebrow--light\">Hiring now?</p>\n          <p class=\"reel-cta-title\">Tell us about the role and Nikita will take it from there.</p>\n          <a class=\"button\" href=\"/contact\">Start a Hiring Conversation</a>\n          <a class=\"light-link\" href=\"/how-we-work\">How we run a search <span aria-hidden=\"true\">\u2192</span></a>\n        </aside>\n      </div>\n    </div>\n    <script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"VideoObject\",\"name\":\"Why growing companies bring in a recruitment partner\",\"description\":\"Hiring under investor pressure with a small team? Nikita on when a specialist partner saves you time.\",\"thumbnailUrl\":\"https://cdn.prod.website-files.com/66a5fdf6d0c2ac84ca88fe93/6ac773bd770ffdcf128d85a7_stellaspire-why-hire-a-consultant.jpg\",\"contentUrl\":\"https://cdn.prod.website-files.com/66a5fdf6d0c2ac84ca88fe93/6ac732ac031bb550498d9cc1_stellaspire-why-hire-a-consultant.mp4\",\"uploadDate\":\"2026-10-08\",\"duration\":\"PT23S\",\"inLanguage\":[\"hi\",\"en\"],\"publisher\":{\"@type\":\"Organization\",\"name\":\"Stellaspire\",\"url\":\"https://www.stellaspire.com/\"}},{\"@type\":\"VideoObject\",\"name\":\"How we check a candidate before you meet them\",\"description\":\"Background, motivation and fit: what we verify before a profile reaches your inbox.\",\"thumbnailUrl\":\"https://cdn.prod.website-files.com/66a5fdf6d0c2ac84ca88fe93/6ac773bde01304e3ada60e19_stellaspire-background-check.jpg\",\"contentUrl\":\"https://cdn.prod.website-files.com/66a5fdf6d0c2ac84ca88fe93/6ac732ab99a67933d1f2b29f_stellaspire-background-check.mp4\",\"uploadDate\":\"2026